# Security
JWT_SECRET=replace_with_a_long_random_jwt_secret
SECRET_KEY=replace_with_a_long_random_session_secret
FERNET_KEY=replace_with_a_valid_32_byte_url_safe_base64_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie-based auth (recommended)
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_ACCESS_NAME=optilearn_access_token
AUTH_COOKIE_REFRESH_NAME=optilearn_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# CSRF (double-submit token)
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=optilearn_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://YOUR_FRONTEND_DOMAIN/api/auth/callback

# File Storage
UPLOAD_DIR=./uploads

# Integrations
GROQ_API_KEY=your_groq_api_key
NOMIC_API_KEY=your_nomic_api_key

# Vector retrieval performance (pgvector)
VECTOR_EMBEDDING_DIM=768
PGVECTOR_ENABLE_FTS_GIN_INDEX=true
PGVECTOR_ENABLE_HNSW=true
PGVECTOR_AUTO_MIGRATE_VECTOR_DIMENSION=true
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64

# Frontend Redirect (OAuth callback handoff)
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
FRONTEND_AUTH_CALLBACK_PATH=/auth/callback

# Application Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://YOUR_FRONTEND_DOMAIN"]
RAG_ENABLE_RERANK=false
PDF_EXTRACT_IMAGES=false
DEBUG=false
